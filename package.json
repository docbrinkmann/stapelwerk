{
  "name": "build-my-stack",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "[ -f prisma/schema.prisma ] && prisma generate || exit 0",
    "e2e:smoke:k8s": "bash scripts/k8s-smoke-test.sh --namespace app --deployment web --timeout 180s",
    "dev": "next dev --webpack",
    "build": "next build --webpack && npm run type-check",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "TMPDIR=/tmp tsx src/__tests__/e2e/run-simple-e2e.ts",
    "test:e2e:full": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts",
    "test:e2e:flows": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts -- --suite=flows",
    "test:e2e:perf": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts -- --perf",
    "test:e2e:security": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts -- --security",
    "test:e2e:ci": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts -- --environment=ci --coverage --bail",
    "test:e2e:verbose": "TMPDIR=/tmp tsx src/__tests__/e2e/run-e2e-tests.ts -- --verbose",
    "test:security": "vitest run src/__tests__/security/",
    "test:security:opa": "vitest run src/__tests__/security/policy-opa-integration.test.ts src/__tests__/security/policy-wasm-golden.test.ts",
    "test:security:zap:baseline": "bash security/run-zap-baseline.sh",
    "test:security:zap:full": "bash security/run-zap-full.sh",
    "test:security:all": "npm run test:security && npm run test:security:zap:baseline",
    "ci:policy-check": "node --loader tsx scripts/policy-check.ts",
    "build:exports": "mkdir -p exports/compliance && echo 'ok'",
    "perf:security": "tsx scripts/security-load-tests.ts",
    "test:security:watch": "vitest --watch src/__tests__/security/",
    "test:security:coverage": "vitest run --coverage src/__tests__/security/",
    "test:playwright": "playwright test",
    "test:unit": "vitest run --exclude 'src/__tests__/{api,e2e,integration,security}/**'",
    "test:integration": "vitest run src/__tests__/integration",
    "test:integration:security": "vitest run src/tests/integration/security-stack.test.ts",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=json --reporter=html",
    "test:ui": "vitest --ui",
    "test:silent": "vitest run --silent",
    "test:changed": "vitest related",
    "test:affected": "vitest run --changed",
    "test:debug": "vitest --inspect-brk --no-coverage",
    "test:types": "tsc --noEmit",
    "test:all": "npm run test:types && npm run test:ci && npm run test:e2e",
    "test:setup": "npm run db:generate && npm run db:push",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "seed:flags": "tsx scripts/seed-security-feature-flags.ts",
    "seed:security-core": "tsx scripts/seed-security-core.ts",
    "dev:concurrent": "concurrently \"npm run dev\" \"npm run db:studio\"",
    "dev:ws": "concurrently \"npm run dev\" \"npm run ws:dev\"",
    "ws:dev": "tsx --watch server/ws-server.ts",
    "ws:start": "tsx server/ws-server.ts",
    "dev:docker": "docker-compose up --build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build --no-cache",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:restart": "docker-compose restart",
    "docker:shell": "docker-compose exec app sh",
    "docker:db:shell": "docker-compose exec postgres psql -U postgres -d build_my_stack_dev",
    "docker:db:migrate": "docker-compose exec app npm run db:migrate",
    "docker:db:generate": "docker-compose exec app npm run db:generate",
    "docker:db:studio": "docker-compose exec app npm run db:studio",
    "docker:db:reset": "docker-compose exec app npm run db:reset",
    "docker:test": "docker-compose exec app npm run test",
    "docker:test:watch": "docker-compose exec app npm run test:watch",
    "docker:lint": "docker-compose exec app npm run lint",
    "docker:build:prod": "docker build -t build-my-stack:latest .",
    "docker:build:test": "docker build --target builder -t build-my-stack:builder .",
    "docker:run:local": "docker run -p 3000:3000 --env-file .env.local build-my-stack:latest",
    "docker:health": "docker inspect --format='{{json .State.Health}}' $(docker ps -q -f name=build-my-stack)",
    "validate:security": "bash scripts/validate-deployment.sh",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:opa:wasm": "tsx scripts/compile-opa-wasm.ts",
    "build:marketing": "next build",
    "dev:full": "concurrently \"wait-on tcp:5432 && npm run db:generate && npm run dev\" \"npm run db:studio\"",
    "dev:services": "docker-compose up postgres redis -d",
    "setup:dev": "npm run dev:services && wait-on tcp:5432 && npm run db:generate && npm run db:migrate",
    "analyze": "ANALYZE=true npm run build",
    "ci:kubeconform": "bash scripts/validate-k8s.sh",
    "artifact:sample": "DATABASE_URL=file:./prisma/test.db TMPDIR=/tmp tsx scripts/create-artifact.ts",
    "perf:load": "artillery run performance/artillery-load-test.yml",
    "perf:lighthouse": "lhci autorun",
    "perf:all": "npm run perf:load && npm run perf:lighthouse",
    "test:visual": "playwright test --config=playwright-visual.config.ts",
    "test:accessibility": "playwright test src/__tests__/accessibility/",
    "test:performance": "playwright test src/__tests__/performance/",
    "test:all-quality": "npm run test:visual && npm run test:accessibility && npm run test:performance",
    "bundle:analyze": "tsx scripts/analyze-bundle.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@prisma/client": "^6.19.0",
    "@prisma/instrumentation": "^6.19.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.29.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@trpc/client": "^11.7.2",
    "@trpc/react-query": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "@types/pdfkit": "^0.17.3",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/redis": "^4.0.10",
    "@vercel/otel": "^2.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "fuse.js": "^7.1.0",
    "immer": "^11.0.1",
    "lucide-react": "^0.556.0",
    "next": "^16.0.7",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.302.2",
    "prom-client": "^15.1.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-intersection-observer": "^9.16.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "tailwind-merge": "^3.4.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.0.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.0.0",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/artillery": "^1.7.5",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "artillery": "^2.0.26",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "happy-dom": "^20.0.8",
    "jest-axe": "^10.0.0",
    "jsdom": "^23.0.0",
    "lighthouse": "^13.0.1",
    "marked": "^15.0.4",
    "msw": "^2.11.3",
    "msw-trpc": "^2.0.1",
    "pa11y": "^9.0.1",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^6.19.0",
    "react-syntax-highlighter": "^16.0.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
