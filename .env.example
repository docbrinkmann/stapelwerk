# Environment Variables Template
# Copy to .env.local for development. In production, use Docker secrets for sensitive values.

# App
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BuildMyStack
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# Database (non-sensitive)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=build_my_stack_dev
DB_USER=buildmystack_user
# Sensitive: use Docker secret in production; for dev only:
DB_PASSWORD=devpassword

# Prisma URLs (dev/testing only)
DATABASE_URL="postgresql://buildmystack_user:devpassword@localhost:5432/build_my_stack_dev?schema=public"
DIRECT_URL="postgresql://buildmystack_user:devpassword@localhost:5432/build_my_stack_dev?schema=public"
DATABASE_TEST_URL="postgresql://buildmystack_user:devpassword@localhost:5432/build_my_stack_test?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Sensitive: use Docker secret in production; for dev only:
REDIS_PASSWORD=

# JWT (Sensitive: use Docker secret in production; for dev only)
JWT_SECRET=dev-jwt-secret

# Optional integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
FEATURE_FLAGS_PROVIDER=internal
AI_CACHE_ENABLED=true
AI_CACHE_TTL=1h
RATE_LIMITING_ENABLED=true

# Audit log archival (S3)
AUDIT_S3_BUCKET=buildmystack-audit-archives
AUDIT_S3_REGION=us-east-1
# Provide AWS credentials for S3 in production (use Docker secrets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional encryption key (use Docker secret in production)
AUDIT_ENCRYPTION_KEY=dev-change-me

# OpenTelemetry Configuration
# Enable verbose logging for OpenTelemetry (set to 1 for development, 0 for production)
NEXT_OTEL_VERBOSE=0
# OTLP exporter endpoint (for sending traces/metrics/logs to a collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: OTLP protocol (http/protobuf or grpc)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional: Sample rate for traces (1.0 = 100%, 0.1 = 10%)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Service name override (defaults to 'build-my-stack' from instrumentation.ts)
OTEL_SERVICE_NAME=build-my-stack

# ArgoCD GitOps Configuration
# ArgoCD server URL (e.g., argocd.example.com:443)
ARGOCD_SERVER_URL=localhost:8080
# ArgoCD authentication token (recommended for production)
ARGOCD_AUTH_TOKEN=
# Alternative: username/password authentication (for development)
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=
# Allow insecure connections (set to false in production with proper TLS)
ARGOCD_INSECURE=true
# Use gRPC-web protocol (set to true if behind HTTP proxy)
ARGOCD_GRPC_WEB=false

# Pulumi Infrastructure as Code Configuration
# Pulumi access token (for Pulumi Cloud backend)
PULUMI_ACCESS_TOKEN=
# Pulumi backend URL (optional: use local file backend, S3, etc.)
PULUMI_BACKEND_URL=
# Pulumi config passphrase (for encrypting secrets in local backend)
PULUMI_CONFIG_PASSPHRASE=
# Pulumi workspace directory (for storing stack state)
PULUMI_WORK_DIR=./tmp/pulumi-workspaces
