# ============================================================================
# Stapelwerk — environment template
#
# Self-hosting (docker-compose.selfhost.yml): copy to `.env`, set the two
# REQUIRED values, everything else has working defaults.
# Local development (npm run dev): copy to `.env.local` and use the
# "Development" section at the bottom.
# ============================================================================

# --- Required -----------------------------------------------------------------
# Postgres password for the bundled database container.
POSTGRES_PASSWORD=
# Session-signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Self-host options (defaults work for http://localhost) -------------------
POSTGRES_DB=stapelwerk
POSTGRES_USER=stapelwerk
# Public URLs as the BROWSER sees them. Change when serving on a LAN name,
# e.g. http://server.lan:3000 and ws://server.lan:3001.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000
APP_PORT=3000
WS_PORT_PUBLIC=3001
# Initial login: demo@stapelwerk.dev / this password (set before the
# migrate/seed step; there is no self-serve sign-up).
SEED_DEMO_PASSWORD=changeme
# Shared secret between app and websocket service for the direct-deploy
# bridge. Generate with: openssl rand -hex 32. Leave empty to disable.
DEPLOY_BRIDGE_TOKEN=
# Web terminal into deployed stacks: docker = enabled (ownership-gated),
# echo = disabled dry mode.
TERMINAL_EXECUTOR=docker
# Prebuilt image override (until one is published, `--build` builds locally).
#STAPELWERK_IMAGE=stapelwerk
#STAPELWERK_TAG=latest

# --- Billing (hosted instance only; unset = self-host = no gates) ------------
# Master switch. Unset/false = open-core self-host build, zero plan gating.
BILLING_ENABLED=false
# Polar (Merchant of Record). Point POLAR_API_BASE at the sandbox for staging.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# POLAR_API_BASE=https://sandbox-api.polar.sh
# Product ids per plan (UUIDs from the Polar dashboard).
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_FLEET=
# One-time "verified deploy" (€29) product. See LAUNCH-RUNBOOK Gate D.
POLAR_PRODUCT_VERIFIED_DEPLOY=
# ed25519 private key (PKCS8 PEM) that signs verified-deploy reports. Mint one at
# launch (Gate D/C); when unset, reports are generated as unsigned drafts.
VERIFIED_DEPLOY_SIGNING_KEY=

# --- Development (npm run dev; copy into .env.local) ---------------------------
#NODE_ENV=development
#DATABASE_URL="postgresql://stapelwerk_user:devpassword@localhost:5432/build_my_stack_dev?schema=public"
#DIRECT_URL="postgresql://stapelwerk_user:devpassword@localhost:5432/build_my_stack_dev?schema=public"
#DATABASE_TEST_URL="postgresql://stapelwerk_user:devpassword@localhost:5432/build_my_stack_test?schema=public"
#REDIS_URL=redis://localhost:6379
# Optional error reporting
#SENTRY_DSN=
