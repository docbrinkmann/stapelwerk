# Stapelwerk Production Environment Variables
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control

# ======================
# Database Configuration
# ======================
POSTGRES_DB=stapelwerk
POSTGRES_USER=stapelwerk_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_32PLUS_CHARS

# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://stapelwerk_user:CHANGE_ME@postgres:5432/stapelwerk

# ======================
# Application Configuration
# ======================
NODE_ENV=production
PORT=3000
APP_PORT=3000

# Public application URL
NEXT_PUBLIC_APP_URL=https://stapelwerk.minilab.live

# ======================
# Authentication (NextAuth.js)
# ======================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
NEXTAUTH_URL=https://stapelwerk.minilab.live

# ======================
# GitLab Container Registry
# ======================
CI_REGISTRY=registry.gitlab.minilab.live
CI_REGISTRY_IMAGE=registry.gitlab.minilab.live/username/stapelwerk
DOCKER_IMAGE_TAG=latest

# ======================
# Sentry Error Tracking (Optional)
# ======================
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ======================
# Redis (Optional)
# ======================
REDIS_URL=

# ======================
# CORS Configuration
# ======================
ALLOWED_ORIGINS=https://stapelwerk.minilab.live

# ======================
# Feature Flags (Optional)
# ======================
ENABLE_ANALYTICS=true
ENABLE_ERROR_TRACKING=true

# ======================
# Email Configuration (Optional)
# ======================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ======================
# Storage Configuration (Optional)
# ======================
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# ======================
# API Rate Limiting (Optional)
# ======================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ======================
# Logging (Optional)
# ======================
LOG_LEVEL=info
LOG_FORMAT=json
